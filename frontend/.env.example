# Production Railway backend — MUST include https://
# Wrong: guardian-ai-production-62fb.up.railway.app  (browser hits Vercel → HTML error)
# Right:
VITE_API_BASE_URL=https://guardian-ai-production-62fb.up.railway.app

# Optional: verbose API logs in production builds
# VITE_DEBUG_API=true

# Legacy alias (still supported if VITE_API_BASE_URL is unset)
# VITE_API_URL=https://guardian-ai-production-62fb.up.railway.app
