# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended model for free tier
GEMINI_MODEL=gemini-2.5-flash

# Max wait for Gemini (ms) — Railway requests can be slow
GEMINI_TIMEOUT_MS=55000

# Server (Railway sets PORT automatically — do not hardcode in production)
PORT=3001
NODE_ENV=production

# Comma-separated frontend origins (local + Vercel — no trailing slash)
FRONTEND_URL=https://guardian-ai-olive.vercel.app,http://localhost:5173
